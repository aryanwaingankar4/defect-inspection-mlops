# Copy to .env and fill in. Never commit .env. Never put real values in this file.
# `make train` / `make train-smoke` load .env via `uv run --env-file`; tests never do.

# API
API_KEY=

# MLflow on DagsHub (ADR-018). Leave MLFLOW_TRACKING_URI empty to log to a local ./mlruns store.
# Example URI shape: https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Model registry
MODEL_NAME=steel-defect-classifier
MODEL_ALIAS=champion

# Database (ADR-014): SQLite locally, Azure PostgreSQL in the cloud
DATABASE_URL=sqlite:///data/predictions.db

# Kaggle CLI (or ~/.kaggle/kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=
