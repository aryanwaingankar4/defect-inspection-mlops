# Copy to .env and fill in. Never commit .env. Never put real values in this file.
# `make train` / `make train-smoke` load .env via `uv run --env-file`; tests never do.

# API (TASK-018, ADR-028): /predict and /feedback need it in the X-API-Key header.
# Use a long random value. `make serve` refuses to start without it. Never log or print it.
# `make docker-up` passes only API_KEY and AUDIT_SALT to the API container (DATABASE_URL is set in
# docker-compose.yml).
API_KEY=

# Random audit (ADR-030): secret salt that decides which accepted predictions are audited.
# Use a long random value; the API refuses to start without it while serving.audit_rate > 0.
AUDIT_SALT=

# Grafana admin password for the local stack (TASK-032, `make docker-up`). Required; anonymous access is off.
GRAFANA_ADMIN_PASSWORD=

# MLflow on DagsHub (ADR-018). Leave MLFLOW_TRACKING_URI empty to log to a local ./mlruns store.
# Example URI shape: https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Model registry
MODEL_NAME=steel-defect-classifier
MODEL_ALIAS=champion

# Review UI (ADR-031, `make review-ui`): password for the local Streamlit review queue.
REVIEWER_PASSWORD=

# Database (ADR-014): SQLite locally, Azure PostgreSQL in the cloud
DATABASE_URL=sqlite:///data/predictions.db

# Kaggle CLI (or ~/.kaggle/kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=
