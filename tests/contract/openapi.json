{
  "components": {
    "schemas": {
      "Body_predict_predict_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_predict_predict_post",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Body of every 4xx/5xx answer.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "error": {
            "description": "short machine-readable code, e.g. near_blank",
            "title": "Error",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "detail",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FeedbackRequest": {
        "properties": {
          "label": {
            "maxLength": 64,
            "title": "Label",
            "type": "string"
          },
          "request_id": {
            "pattern": "^[0-9a-f]{32}$",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "label"
        ],
        "title": "FeedbackRequest",
        "type": "object"
      },
      "FeedbackResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "stored": {
            "title": "Stored",
            "type": "boolean"
          }
        },
        "required": [
          "request_id",
          "stored",
          "detail"
        ],
        "title": "FeedbackResponse",
        "type": "object"
      },
      "HealthResponse": {
        "description": "``model``, ``bundle_built_at`` and ``database`` are present once the model is loaded.",
        "properties": {
          "bundle_built_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bundle Built At"
          },
          "database": {
            "anyOf": [
              {
                "enum": [
                  "ok",
                  "unavailable"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ModelInfo": {
        "properties": {
          "alias": {
            "title": "Alias",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "precision": {
            "title": "Precision",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "alias",
          "precision"
        ],
        "title": "ModelInfo",
        "type": "object"
      },
      "PredictResponse": {
        "properties": {
          "calibrated_confidence": {
            "description": "max softmax(logits / T), ADR-006/025",
            "title": "Calibrated Confidence",
            "type": "number"
          },
          "energy": {
            "description": "-T * logsumexp(logits / T); higher = less familiar",
            "title": "Energy",
            "type": "number"
          },
          "image_sha256": {
            "title": "Image Sha256",
            "type": "string"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          },
          "model": {
            "$ref": "#/components/schemas/ModelInfo"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "prediction": {
            "title": "Prediction",
            "type": "string"
          },
          "reasons": {
            "description": "why the image goes to review: low_confidence and/or ood (ADR-023, ADR-027), or audit for a random sample of otherwise accepted images (ADR-030); empty if it does not",
            "items": {
              "enum": [
                "low_confidence",
                "ood",
                "audit"
              ],
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "routed_to_review": {
            "title": "Routed To Review",
            "type": "boolean"
          },
          "thresholds": {
            "$ref": "#/components/schemas/ThresholdInfo"
          }
        },
        "required": [
          "request_id",
          "prediction",
          "calibrated_confidence",
          "energy",
          "routed_to_review",
          "reasons",
          "model_version",
          "model",
          "thresholds",
          "image_sha256",
          "latency_ms"
        ],
        "title": "PredictResponse",
        "type": "object"
      },
      "ThresholdInfo": {
        "properties": {
          "audit_rate": {
            "title": "Audit Rate",
            "type": "number"
          },
          "ood_energy": {
            "title": "Ood Energy",
            "type": "number"
          },
          "review": {
            "title": "Review",
            "type": "number"
          },
          "temperature": {
            "title": "Temperature",
            "type": "number"
          }
        },
        "required": [
          "temperature",
          "review",
          "ood_energy",
          "audit_rate"
        ],
        "title": "ThresholdInfo",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "description": "API key from the API_KEY env var: missing -> 401, wrong -> 403",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "NEU steel-defect classifier (ONNX) with calibrated confidence and review routing. Reviewer and drift are simulated in this project.",
    "title": "Steel defect inspection API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/feedback": {
      "post": {
        "operationId": "feedback_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "X-API-Key header missing"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "X-API-Key wrong"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "invalid request or image (undecodable, too small, too many pixels, near blank)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "unexpected error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "model not loaded or prediction could not be logged"
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ],
        "summary": "Feedback"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "not ready or degraded"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "prometheus_metrics_get",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Prometheus"
      }
    },
    "/predict": {
      "post": {
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_predict_predict_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "X-API-Key header missing"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "X-API-Key wrong"
          },
          "411": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content-Length missing"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "file too large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "image format not allowed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "invalid request or image (undecodable, too small, too many pixels, near blank)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "unexpected error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "model not loaded or prediction could not be logged"
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ],
        "summary": "Predict"
      }
    }
  }
}
